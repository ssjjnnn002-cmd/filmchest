{
  "expo": {
    "name": "필름함",
    "slug": "filmchest",
    "version": "1.5.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "filmchest",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.vercel.filmchest",
      "versionCode": 19,
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/zip"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-zip-compressed"
            },
            {
              "scheme": "file",
              "mimeType": "application/zip"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Pretendard-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Medium.otf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Pretendard-SemiBold.otf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Bold.otf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Pretendard-ExtraBold.otf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-router",
      "expo-sqlite",
      "./plugins/withReleaseSigning",
      "./plugins/withBackupRules",
      "./plugins/withFixedFontScale",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "스캔 사진을 갤러리에 저장해요.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "*/*"
          ],
          "androidMultiIntentFilters": [
            "*/*"
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141414",
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
