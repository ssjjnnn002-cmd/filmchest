{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "filmchest-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5199
    },
    {
      "name": "meter-lab",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5288",
        "--directory",
        "prototypes/meter"
      ],
      "port": 5288
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5300",
        "--directory",
        "site/public"
      ],
      "port": 5300
    },
    {
      "name": "tumblbug-assets",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "marketing/tumblbug/serve.py",
        "5310"
      ],
      "port": 5310
    }
  ]
}